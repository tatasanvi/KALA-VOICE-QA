{
  "name": "kala-voice-qa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "npm run dev --prefix backend",
    "dev:all": "concurrently -n ASR,BACK,FRONT -c magenta,green,blue \"npm run dev:asr\" \"npm run dev --prefix backend\" \"vite\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dev:asr": "asr-service/.venv/bin/uvicorn main:app --app-dir asr-service --host 127.0.0.1 --port 8500"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "typescript": "^5.5.3",
    "vite": "^5.4.2"
  }
}
