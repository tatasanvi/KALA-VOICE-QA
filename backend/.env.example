# =============================================================================
# KALA VOICE QA — Variables d'environnement du backend
# Copiez ce fichier en backend/.env et renseignez les valeurs.
# backend/.env n'est jamais versionné.
# =============================================================================

# Port d'écoute de l'API Express.
PORT=8000

# Environnement d'exécution : development | production
NODE_ENV=development

# Secret de signature des jetons JWT. OBLIGATOIRE en production :
# sans lui, le serveur refuse de démarrer. En développement, un secret
# aléatoire est généré à chaque démarrage si la variable est absente.
# Générer une valeur : openssl rand -hex 32
JWT_SECRET=

# Service de transcription local (Whisper-small).
ASR_URL=http://127.0.0.1:8500/transcribe

# Comptes de démonstration (admin@, qualite@, agent@).
# Ils ne sont créés que si SEED_DEMO_ACCOUNTS=true, et jamais quand
# NODE_ENV=production. Ils sont marqués « mot de passe à changer ».
SEED_DEMO_ACCOUNTS=false

# Mot de passe des comptes de démonstration. Sans cette variable, aucun
# compte n'est créé. À réserver au développement.
DEMO_PASSWORD=
