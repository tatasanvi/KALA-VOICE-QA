# Copiez ce fichier en backend/.env et adaptez les valeurs à votre environnement.
# Ne renseignez jamais de secrets dans ce fichier versionné.
PORT=8000
DATABASE_PATH=./kala.db
# Laissez DATABASE_URL vide pour utiliser SQLite en local.
DATABASE_URL=
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
JWT_SECRET=
ASR_URL=http://127.0.0.1:8500/transcribe
SEED_DEMO_ACCOUNTS=false
DEMO_PASSWORD=
# Variables de premier administrateur de production (jamais à versionner).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
